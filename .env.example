# OpenRouter API key (required for qwen/haiku/sonnet/opus/deepseek/gemini)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Default model shortcut (optional, default: qwen)
CLODING_DEFAULT_MODEL=qwen

# Optional direct-provider keys (used by specific shortcuts)
# gemini-3
GOOGLE_API_KEY=your-google-api-key
# codex-5
OPENAI_API_KEY=your-openai-api-key
# copilot
GITHUB_TOKEN=your-github-token

# Direct Anthropic API key (for -a model variants like haiku-a, sonnet-a, opus-a)
ANTHROPIC_API_KEY=sk-ant-your-key-here
